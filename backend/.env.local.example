# ============================================================
# PROJECT FORGE — LOCAL LLM CONFIGURATION
# ============================================================
# Copia este ficheiro para .env.local e preenche os valores.
# O .env.local nunca vai para o git.
#
# PRIORIDADE DO PROVIDER:
#   LOCAL_LLM_URL set      → llama.cpp / Ollama / LM Studio (local)
#   ANTHROPIC_BASE_URL set → coarena.ai (cloud Anthropic)
#   nenhum dos dois        → Groq (cloud OpenAI-compatible)
# ============================================================

PORT=3001
ALLOWED_ORIGINS=http://localhost:5173

# ── OPÇÃO 1: Local LLM ────────────────────────────────────────────────────────
# llama.cpp server:  http://localhost:8080/v1
# Ollama:            http://localhost:11434/v1
# LM Studio:         http://localhost:1234/v1

LOCAL_LLM_URL=http://localhost:8080/v1

# Nome do modelo (llama.cpp aceita qualquer string; Ollama usa o nome dado no create)
LOCAL_LLM_MODEL=deepseek-v4-heretic
# LOCAL_LLM_MODEL_FAST=deepseek-v4-heretic   # usa o mesmo para fast calls

# Tokens máximos por resposta (9B model: ctx 8192, safe output: 2048–4096)
LOCAL_LLM_MAX_TOKENS=2048

# llama.cpp e Ollama não precisam de API key real — deixar assim
LOCAL_LLM_API_KEY=not-needed

# ── OPÇÃO 2: coarena.ai (cloud) ───────────────────────────────────────────────
# (comentar se usar local)
# ANTHROPIC_BASE_URL=https://coarena.ai/api
# ANTHROPIC_AUTH_TOKEN=coa_eaac0cc2d1a87e159aec3fccc80a84ea
# ANTHROPIC_MODEL=claude-fable-5-2
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5

# ── OPÇÃO 3: Groq (cloud, fallback automático) ────────────────────────────────
# (usado se nenhum dos dois acima estiver definido)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-20b
